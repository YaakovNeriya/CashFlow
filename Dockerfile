# שורה 1: בוחרים "תמונת בסיס" - מחשב מינימלי שכבר מותקן בו פייתון
FROM python:3.12-slim

# שורה 2: יוצרים תיקייה בתוך הקונטיינר שבה הקוד שלנו יישב
WORKDIR /app

# שורה 3: מעתיקים רק את קובץ הדרישות קודם (טריק לאופטימיזציה - 
# ככה Docker לא מתקין מחדש את כל הספריות בכל שינוי קוד)
COPY requirements.txt .

# שורה 4: מתקינים את כל הספריות (Flask, PyMySQL, וכו')
RUN pip install --no-cache-dir -r requirements.txt

# שורה 5: עכשיו מעתיקים את כל שאר הקוד שלנו לתוך הקונטיינר
COPY . .

# שורה 6: מודיעים ש"הדלת" של הקונטיינר פתוחה בפורט 5000
EXPOSE 5000

# שורה 7: הפקודה שתרוץ כשהקונטיינר נדלק (שימוש ב-Gunicorn לביצועים גבוהים בייצור)
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:5000", "run:app"]
